# Imagen publicada por Cloud Build
PROJECT_ID=descarga-gmail-automatica
REGION=southamerica-west1
AR_REPOSITORY=gmail-downloader
IMAGE_NAME=gmail-cloud-run
IMAGE_TAG=vm-v5

# Secret Manager: solo se indican los nombres, nunca el contenido
CLIENT_SECRET_NAME=google-client-secret-json
OAUTH_TOKEN_SECRET_NAME=google-oauth-token-json

# Google Drive
DRIVE_FOLDER_ID=REEMPLAZAR_CON_ID_DE_CARPETA_DRIVE

# Gmail
GMAIL_QUERY=is:unread
PROCESSED_LABEL=Descarga-Automatica-Procesado
ERROR_LABEL=Descarga-Automatica-Error
PARTIAL_LABEL=Descarga-Automatica-Parcial
IGNORED_LABEL=Descarga-Automatica-Ignorado
MANUAL_LABEL=Descarga-Automatica-Manual
RETRY_LABEL=Descarga-Automatica-Reintento
MAX_EMAILS=20
MARK_AS_READ=true
EXCLUDE_ERROR_MESSAGES=true
EXCLUDE_IGNORED_MESSAGES=true
EXCLUDE_MANUAL_MESSAGES=true

# Directorios persistentes montados desde el disco de la VM
DOWNLOAD_DIR=/data/downloads
BROWSER_PROFILE_DIR=/data/chrome-profile
STATE_DIR=/data/state

# Archivos grandes y navegador
MAX_FILE_SIZE_MB=8192
DOWNLOAD_CHUNK_SIZE_MB=4
UPLOAD_CHUNK_SIZE_MB=8
UPLOAD_RETRIES=3
DOWNLOAD_TIMEOUT_SECONDS=1800
BROWSER_HEADLESS=false
BROWSER_HTTP_HANDOFF=true
BROWSER_PROVIDER_ATTEMPTS=2
BROWSER_RETRY_DELAY_SECONDS=3
BROWSER_DIAGNOSTICS=true
MAX_DIAGNOSTIC_FILES=20
MAX_MESSAGE_ATTEMPTS=5
STALE_RUN_HOURS=24
ENABLE_SENDGB=true

# Mantener false durante las pruebas. Se cambia a true únicamente cuando
# Cloud Scheduler quede configurado para encender la VM cada 15 minutos.
AUTO_SHUTDOWN=false
